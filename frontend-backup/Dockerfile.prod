# Stage 1: Build the React application
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package.json package-lock.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .


# Build the application
RUN npx vite build

# Stage 2: Serve with Nginx (handled by main nginx container)
FROM nginx:alpine

# Copy built files to nginx html directory
COPY --from=builder /app/dist /usr/share/nginx/html

# Create a dummy nginx config (will be overridden by main nginx)
RUN echo "server { listen 80; location / { root /usr/share/nginx/html; } }" > /etc/nginx/conf.d/default.conf
